# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://arxatec:arxatec@localhost:5444/arxatec_academy?schema=public

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ISSUER=arxatec-academy

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Google OAuth 2.0
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=smtp
# Usar el correo autenticado en SMTP_USER o un alias autorizado por ese servidor.
EMAIL_FROM=Arxatec Academy <cuenta-smtp@tu-dominio.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Semilla (solo desarrollo: `pnpm seed` aborta con NODE_ENV=production)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@arxatec.pe
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=estudiante@arxatec.pe
SEED_STUDENT_PASSWORD=

# ---------------------------------------------------------------------------
# Almacenamiento de archivos
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage
STORAGE_PUBLIC_URL=http://localhost:3001/files

VIDEO_PROVIDER_DRIVER=fake
# En producción usar VIDEO_PROVIDER_DRIVER=live. El modo legacy 'vimeo' equivale a live.
VIDEO_PROBE_TIMEOUT_MS=3000

REPORTING_UTC_OFFSET_MINUTES=-300
ADMIN_EXPORT_MAX_ROWS=50000
NOTIFICATIONS_IP_HASH_SALT=cambia-esto-por-una-sal-de-al-menos-16-caracteres

# S3 + CloudFront: activar STORAGE_DRIVER=s3.
# /public/ se entrega sin firma; /private/ exige URL firmada.
AWS_REGION=
S3_ACADEMY_PRODUCT_BUCKET=
CDN_ACADEMY_PRODUCT_BASE_URL=
# Omitir ambas para usar IAM/default credential chain. Si se usan, completar ambas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ID de la clave pública de CloudFront asociada al grupo de claves confiable.
CLOUDFRONT_ACADEMY_PRODUCT_KEY_PAIR_ID=
# Configurar exactamente una fuente: PEM inline (admite \\n) o archivo PEM privado.
CLOUDFRONT_ACADEMY_PRODUCT_PRIVATE_KEY=
CLOUDFRONT_ACADEMY_PRODUCT_PRIVATE_KEY_PATH=
CLOUDFRONT_SIGNED_URL_TTL_SECONDS=300
# También se admiten los nombres genéricos de docs/ENV.md; producto tiene prioridad con S3.
