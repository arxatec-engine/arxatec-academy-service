{
  "name": "arxatec-academy-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de Arxatec Academy",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "infisical": "infisical run --projectId=\"$(node -p \"require('./.infisical.json').workspaceId\")\"",
    "dev": "pnpm infisical --env=dev -- pnpm dev:local",
    "dev:local": "pnpm prisma:generate && tsx watch src/server.ts",
    "build": "pnpm build:prod",
    "build:dev": "pnpm infisical --env=dev -- pnpm build:local",
    "build:prod": "pnpm infisical --env=prod -- pnpm build:local",
    "build:local": "pnpm prisma:generate && tsc && tsc-alias && node scripts/copy_certificate_assets.mjs",
    "start": "pnpm infisical --env=prod -- pnpm start:local",
    "start:local": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "docs:citations": "node scripts/check_doc_citations.mjs",
    "storage:check:development": "pnpm infisical --env=dev -- pnpm storage:check:development:local",
    "storage:check:development:local": "pnpm build:local && node scripts/check_storage_development.mjs",
    "test": "jest --runInBand",
    "test:integration:postgres": "jest --runInBand --config config/jest/jest.integration.config.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "pnpm infisical --env=dev -- pnpm prisma:migrate:local",
    "prisma:migrate:local": "prisma migrate dev",
    "prisma:deploy": "pnpm infisical --env=prod -- pnpm prisma:deploy:local",
    "prisma:deploy:local": "prisma migrate deploy",
    "seed": "pnpm infisical --env=dev -- pnpm seed:local",
    "seed:local": "tsx src/seed/index.ts",
    "seed:exams": "pnpm infisical --env=dev -- pnpm seed:exams:local",
    "seed:exams:local": "tsx src/seed/exams.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/cloudfront-signer": "^3.1149.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
