model users {
  id                String        @id @default(cuid())
  full_name         String        @db.VarChar(120)
  email             String        @unique @db.VarChar(254)
  password_hash     String?
  role              user_role     @default(STUDENT)
  organization      String?       @db.VarChar(160)
  is_independent    Boolean       @default(false)
  city              user_city
  city_other        String?       @db.VarChar(80)
  avatar_url        String?
  avatar_key        String?       @db.VarChar(255)
  email_verified_at DateTime?
  auth_provider     auth_provider @default(PASSWORD)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  auth_sessions   auth_sessions[]
  auth_tokens     auth_tokens[]
  oauth_accounts  oauth_accounts[]
  enrollments     enrollments[]
  lesson_progress lesson_progress[]
  comments        comments[] @relation("comment_author")
  hidden_comments comments[] @relation("comment_hidden_by")
  deleted_comments comments[] @relation("comment_deleted_by")
  comment_reports comment_reports[]
  reviewed_reports comment_reports[] @relation("report_reviewer")
  notification_signups notification_signups[]
  topic_requests topic_requests[]
}
